# ── SERVER ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MONGODB ────────────────────────────────────────────
# MongoDB Atlas: Cluster → Connect → Drivers → copy URI
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/eventrevo?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_64_chars
JWT_EXPIRE=30d

# ── CLIENT URL ─────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ── GOOGLE CLOUD STORAGE ───────────────────────────────
# GCP Console → IAM → Service Accounts → Create Key (JSON)
# Download JSON, base64 encode it: base64 -i key.json
GCS_BUCKET_NAME=eventrevo-media
GCS_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./config/gcs-key.json

# ── STRIPE ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
DEPOSIT_PERCENTAGE=20

# ── EMAIL (Nodemailer) ─────────────────────────────────
# Option A: Gmail App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@eventrevo.com.au

# Option B: Resend.com (recommended)
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_USER=resend
# EMAIL_PASS=re_...

# ── GOOGLE OAUTH (optional) ────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── GOOGLE CALENDAR ────────────────────────────────────
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/callback
